# =============================================================
# Auth Service — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.
#
# K8s deployment: these map to Secret and ConfigMap objects.
# Docker Compose: loaded automatically via env_file: .env
# Local dev: set as VM options or export in your shell.
# =============================================================

# -------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------
# DB_URL format for Docker Compose: jdbc:postgresql://postgres:5432/${DB_NAME}
# DB_URL format for local dev:      jdbc:postgresql://localhost:5432/<your_db>
DB_URL=
DB_NAME=auth
DB_USERNAME=postgres          # must match POSTGRES_USER below
DB_PASSWORD=

# Used by the postgres container in docker-compose
POSTGRES_USER=postgres        # keep in sync with DB_USERNAME
POSTGRES_PASSWORD=            # keep in sync with DB_PASSWORD
POSTGRES_DB=auth              # keep in sync with DB_NAME

# -------------------------------------------------------------
# Redis
# -------------------------------------------------------------
# REDIS_HOST for Docker Compose: redis (service name)
# REDIS_HOST for local dev:      localhost
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------------------------------------------
# JWT
# -------------------------------------------------------------
# JWT_SECRET must be a strong random string (min 32 chars).
# Generate one with: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000       # 15 minutes in ms
JWT_REFRESH_EXPIRATION=604800000   # 7 days in ms

# -------------------------------------------------------------
# Brute-force protection (Phase 5)
# -------------------------------------------------------------
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW=15m            # accepts 15m, 1h, PT15M, or raw ms
AUTH_OTP_TTL=10m                   # password-reset OTP validity window

# -------------------------------------------------------------
# Outbound mail (forgot-password OTP) — Resend
# -------------------------------------------------------------
# AUTH_MAIL_PROVIDER:
#   resend   → call the Resend HTTP API (production)
#   logging  → write OTP to application log (safe for local dev — no email sent)
AUTH_MAIL_PROVIDER=resend

# Display "From" header. Defaults to onboarding@resend.dev for the Resend sandbox.
# For a verified custom domain, set this to noreply@your-domain.com.
AUTH_MAIL_FROM_ADDRESS=onboarding@resend.dev
AUTH_MAIL_FROM_NAME=Auth Service (nct682000)

# Resend (https://resend.com) — free tier: 100 emails/day, 3,000/month.
# Setup:
#   1. Create an account at https://resend.com
#   2. Go to https://resend.com/api-keys and create a new API key
#   3. Paste the "re_xxxxxxxxxxxxxxxx" value below
#   4. Sandbox mode (AUTH_MAIL_FROM_ADDRESS=onboarding@resend.dev) can ONLY
#      deliver to the email address you registered your Resend account with.
#      To send to anyone, verify a domain at https://resend.com/domains and
#      set AUTH_MAIL_FROM_ADDRESS=noreply@your-domain.com
RESEND_API_KEY=re_KtSi5gi5_7fhpVprZ8nZf2gNbcQ7xBTi6
